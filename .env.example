# Copy this file to .env beside run_training.py and replace the dataset path.
# Absolute paths work on any host. Relative paths start at the training folder.
# Quote paths containing spaces. Values are literal; no $VARIABLE expansion.
# Training reads the prepared NPZ release; no MySQL credentials are needed.
AIS_DATASET_DIR=/path/to/full_5_60_20260918T072424Z

# cpu: CPU only. gpu: require a working GPU (error if unavailable).
# auto: CPU on macOS (known Metal issue); elsewhere GPU if detected.
AIS_DEVICE=auto

# Use persistent cluster storage; every run gets a new subdirectory.
AIS_RUNS_DIR=./runs
AIS_JOBS_DIR=./jobs
AIS_BATCH_SIZE=64

# Optional alternative: leave AIS_DATASET_DIR blank and use a release pointer.
# Its JSON "output" must point to the dataset on THIS computer.
# AIS_RELEASE_POINTER=/path/to/current_release.json

# CLI overrides exported AIS_* variables, which override this file.
# Do not set CUDA_VISIBLE_DEVICES here: retain the scheduler's GPU allocation.
