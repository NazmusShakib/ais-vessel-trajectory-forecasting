# Copy to jasmin/config.sh on JASMIN, then edit these paths.
# This is a shell configuration for the queue wrappers, separate from .env.
# Use the Python executable in a Linux environment with the dependencies installed.
export AIS_PYTHON='/REPLACE_WITH_YOUR_LINUX_ENV/bin/python'
# Must contain groups/, manifest.json and shard_index.csv after extraction.
export AIS_DATASET_DIR='/REPLACE_WITH_EXTRACTED_DATASET/full_5_60_20260918T072424Z'
# Choose persistent writable storage with sufficient quota.
export AIS_RUNS_DIR='/REPLACE_WITH_RESULTS_STORAGE/ais_results'
export AIS_JOBS_DIR='/REPLACE_WITH_RESULTS_STORAGE/ais_worker_logs'
export AIS_BATCH_SIZE=64
# Row-aligned environmental sidecars, one Parquet per release shard. Required only when a run
# requests environmental blocks; leave unset for trajectory-only runs. Must be the directory
# built by build_env_sidecar.py against THIS release -- a sidecar from another release is
# row-aligned to the wrong shards, and read_sidecar will refuse it on the carried keys.
export AIS_ENV_SIDECAR='/REPLACE_WITH_EXTRACTED_SIDECAR/env_sidecar'
# If your chosen Python environment needs a module or activation, add it here.
# Keep the module version/environment fixed for every comparison experiment.